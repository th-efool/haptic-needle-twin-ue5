# ==============================================================================
# Unreal Engine 5.x Git Ignore
# Comprehensive ignore rules for UE5 + C++ + Python + Visual Studio / Rider / VS Code
# ==============================================================================

# ------------------------------------------------------------------------------
# Visual Studio / IDE Project & User Files
# ------------------------------------------------------------------------------
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.user
*.userosv
*.userprefs

# Xcode Project Files (Engine generated)
*.xcodeproj
*.xcworkspace

# JetBrains Rider / CLion / IntelliJ IDEA
.idea/
*.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# Unreal Engine Build, Intermediate, and Cache Directories
# ------------------------------------------------------------------------------
# Binary files
Binaries/*
Plugins/**/Binaries/*

# Intermediate files generated during compilation and cook
Intermediate/*
Plugins/**/Intermediate/*

# Saved configuration, logs, crash reports, and local editor state
Saved/*

# Derived Data Cache (DDC)
DerivedDataCache/*

# Builds and packaging output
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps (can be regenerated by lighting/navmesh builds)
*_BuiltData.uasset

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Engine temporary logs and diagnostics
FileOpenLog.txt
*.log
*.dmp
*.rec
*.profdata
*.trace

# ------------------------------------------------------------------------------
# Compiled Binaries, Libraries & Objects
# ------------------------------------------------------------------------------
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# ------------------------------------------------------------------------------
# Python Environments & Artifacts
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
.Python
dist/
*.egg-info/
.eggs/
eggs/
develop-eggs/
pip-wheel-metadata/

# Testing, typing, and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pytype/
.ipynb_checkpoints/

# Environment configurations and secrets
.env
.env.local

# ------------------------------------------------------------------------------
# Operating System Temporary & Metadata Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
